# Copia este archivo a apps/web/.env.local y rellena los valores.
# Con Supabase local, sácalos de `pnpm exec supabase status`.
# Nunca pongas aquí ni en NEXT_PUBLIC_* la clave secreta (service role).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos push (opcional): clave pública de `pnpm push:keys`. Sin ella no se ofrecen avisos. README > "Avisos push".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
