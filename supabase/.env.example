# Copia este archivo a supabase/.env (no se sube al repo) y reinicia: pnpm db:stop && pnpm db:start
# Pasos para obtener las credenciales: README.md > "Login social en local".

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
