# Copia este archivo a supabase/functions/.env (no se sube al repo). Pasos: README.md > "Avisos push".
# Claves de `pnpm push:keys`; la pública también va a apps/web/.env.local (NEXT_PUBLIC_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (obligatorio en el protocolo VAPID).
VAPID_SUBJECT=mailto:tu-correo@example.com
# El mismo valor que el secreto `push_webhook_secret` del Vault.
PUSH_WEBHOOK_SECRET=
